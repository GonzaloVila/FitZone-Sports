# Variables de docker-compose.yml. Todas son opcionales: sin un archivo .env, el sistema levanta en local con los valores
# por defecto. Para otro entorno, copiar a .env (no se sube al repositorio) y completar.

# Base de datos del contenedor `db`.
POSTGRES_USER=fitzone
POSTGRES_PASSWORD=fitzone
POSTGRES_DB=fitzone

# Secreto para firmar los JWT. Fuera de una máquina local, usar uno largo y aleatorio.
JWT_SECRET=

# Clave AES-256 (32 bytes en base64) para cifrar el secreto TOTP de los socios. Generar una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=

# Dónde se publica cada parte. El frontend se compila con URL_API; el backend acepta pedidos (CORS) desde URL_WEB.
URL_WEB=http://localhost:8080
URL_API=http://localhost:3000/api/v1

# true solo si la app se sirve por https.
REFRESH_COOKIE_SECURE=false
