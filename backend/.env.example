# Copiar a .env y completar (nunca commitear .env)
# PostgreSQL (Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fitzone?schema=public"

# Pasarela de pagos (RF-13 / RNF-02) - token de MercadoPago (solo prod)
MP_TOKEN=""

# Entorno: development | test | production
NODE_ENV="development"

  # Puerto del servidor HTTP
  PORT=3000

  # Auth JWT (Unidad III). Secreto para firmar/verificar access_token y su
  # vencimiento en segundos (expires_in del contrato). JWT_SECRET tiene un
  # default solo valido para dev/test: en produccion se completa acá.
  JWT_SECRET=""
  JWT_EXPIRES_IN=900

  # Sesion con refresh token (POST /auth/refresh y /auth/logout). El access
  # token vive poco (JWT_EXPIRES_IN, 900 s = 15 min) y se renueva con un refresh
  # token rotativo que dura REFRESH_EXPIRES_IN segundos (604800 = 7 dias).
  # Los clientes web lo reciben en la cookie HttpOnly "refresh_token"; los
  # moviles (header X-Cliente: movil) lo reciben en el body del login.
  REFRESH_EXPIRES_IN=604800

  # Origenes permitidos por CORS, separados por coma (el front es Vite). Es
  # tambien la lista contra la que se valida el header Origin cuando el refresh
  # token llega por cookie. Sin comodin: el CORS va con credenciales.
  CORS_ORIGINS=http://localhost:5173

  # Cookie del refresh token. SAMESITE: strict | lax | none (default lax).
  # SECURE: true | false; sin valor es true solo si NODE_ENV=production. Con
  # SAMESITE=none, SECURE tiene que ser true o la app no arranca.
  REFRESH_COOKIE_SAMESITE=lax
  # REFRESH_COOKIE_SECURE=true

  # TOTP para QR dinamico de socio (RF-04). Clave AES-256 (32 bytes) en
  # base64 para cifrar el secreto en reposo (Socio.totp_secreto).
  TOTP_ENCRYPTION_KEY=""

  # Avisos de cupo liberado por email (RF-08, ADR-05). Con SMTP_* completos el
  # envio es real; si faltan, el observer solo loguea y no sale a la red.
  # Para el modo de prueba de Ethereal (URL de vista previa en el log): ETHEREAL=true
  # MAIL_FROM admite nombre de marca: "FitZone Sports <casilla>". Ojo: Gmail exige
  # que el From sea la propia cuenta (o un alias verificado); no deja usar un
  # dominio ajeno. Con SMTP_PASS de Gmail usar una App Password (requiere 2FA).
  SMTP_HOST=""
  SMTP_PORT=587
  SMTP_SECURE=false
  SMTP_USER=""
  SMTP_PASS=""
  MAIL_FROM="FitZone Sports <casilla@dominio>"
  ETHEREAL=false
