# Dependencias
node_modules/

# Build
dist/
build/
# Incremental TS build info
*.tsbuildinfo

# Entorno (nunca secretos en el repo)
.env
.env.local
.env.test

# Logs
*.log
npm-debug.log*

# Comprobantes generados en runtime (RF-14). El directorio lo crea `ComprobantesService`
# con `mkdir -p`, asi que no hace falta versionar un .gitkeep: lo que hay adentro son
# PDF de cobros, no fuente.
/storage/

# Herramienta local de comparacion de contrato. Vive en el disco pero no se
# versiona: el YAML que se entrega sale de /docs-json, que es el mismo documento
# que ya publica NestJS, asi que el repo no necesita una copia canonica.
/contrato/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
.vitest/
coverage-e2e/
