        +validar(ctx: ContextoReserva) void
    }
    class ValidadorDeReservas {
        -validaciones: ValidacionDeReserva[]
        +validar(ctx: ContextoReserva) void
    }
    class ClaseExiste {
        +validar(ctx: ContextoReserva) void
    }
    class SocioAlDia {
        +validar(ctx: ContextoReserva) void
    }
    class ReservaAnticipada {
        +validar(ctx: ContextoReserva) void
    }
    class ClaseNoComenzada {
